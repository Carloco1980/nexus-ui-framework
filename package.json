{
  "name": "nexus-ui-framework",
  "version": "0.3.0",
  "description": "Modern UI Framework for dashboards, landing pages, WordPress and reusable web applications.",
  "author": "Carlos Santander Díaz",
  "license": "MIT",
  "private": true,

  "scripts": {
    "dev": "npm run watch",
    "build": "postcss assets/css/style.css --config config -o dist/nexus-ui.css",
    "watch": "postcss assets/css/style.css --config config -o dist/nexus-ui.css --watch"
  },

  "keywords": [
    "nexus",
    "ui",
    "framework",
    "dashboard",
    "landing-page",
    "wordpress",
    "design-system",
    "css"
  ],

  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.0"
  }
}